---
// src/components/home.astro
import CodeTerminal from "@/React/CodeTerminal";
---

<section id="home" class="min-h-screen pt-28 pb-16 text-[var(--white)] flex flex-col justify-center">
  <div class="max-w-6xl mx-auto px-4 w-full space-y-20">

    <!-- HERO PRINCIPAL: Presentación, Foto y CTAs de Alto Impacto -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      
      <!-- Columna Texto y Botones (7 columnas) -->
      <div class="lg:col-span-7 space-y-6">
        
        <!-- Badge de Disponibilidad Activa -->
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 text-xs font-mono">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
          <span>Disponible para proyectos y consultoría</span>
        </div>

        <div class="space-y-2">
          <p class="text-sm font-mono text-slate-400">Hola, soy Roberto Carlos Rivera Valderrama</p>
          <h1 class="text-4xl sm:text-6xl font-extrabold tracking-tight leading-tight">
            Software &amp; <br />
            <span class="text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 via-indigo-300 to-purple-400">
              Data Developer
            </span>
          </h1>
        </div>

        <p class="text-sm sm:text-base text-slate-300 leading-relaxed max-w-xl">
          Desarrollo de software y analítica aplicada. Transformo requerimientos complejos en 
          <strong class="text-white font-semibold">soluciones digitales e interactivas</strong> respaldadas por metodologías de investigación, modelado analítico y arquitecturas de datos sólidas con ejecución segura en el cliente.
        </p>

        <!-- Redes y Canales Profesionales -->
        <div class="flex items-center gap-3 pt-1">
          <a 
            href="https://github.com/robertocrivera" 
            target="_blank" 
            rel="noopener noreferrer"
            aria-label="GitHub"
            class="w-10 h-10 rounded-xl bg-[#121622] border border-white/10 flex items-center justify-center text-slate-400 hover:text-white hover:border-cyan-400/50 hover:scale-105 transition"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
            </svg>
          </a>
          <a 
            href="https://linkedin.com" 
            target="_blank" 
            rel="noopener noreferrer"
            aria-label="LinkedIn"
            class="w-10 h-10 rounded-xl bg-[#121622] border border-white/10 flex items-center justify-center text-slate-400 hover:text-white hover:border-cyan-400/50 hover:scale-105 transition"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.88 8.56a1.68 1.68 0 0 0 1.68-1.68c0-.93-.75-1.69-1.68-1.69a1.69 1.69 0 0 0-1.69 1.69c0 .93.76 1.68 1.69 1.68m1.39 9.94v-8.37H5.5v8.37h2.77z"/>
            </svg>
          </a>
          <a 
            href="mailto:tu-correo@ejemplo.com" 
            aria-label="Email Directo"
            class="w-10 h-10 rounded-xl bg-[#121622] border border-white/10 flex items-center justify-center text-slate-400 hover:text-white hover:border-cyan-400/50 hover:scale-105 transition"
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
            </svg>
          </a>
        </div>

        <!-- Botonera Principal: Salto Directo a Trayectoria / CV y Contacto -->
        <div class="flex flex-wrap items-center gap-3 pt-2">
          <a 
            href="#cv-section" 
            class="px-5 py-2.5 rounded-xl bg-cyan-500 hover:bg-cyan-400 text-slate-950 font-bold text-xs font-mono transition shadow-lg shadow-cyan-500/20 flex items-center gap-2"
          >
            <span>Ver Perfil Curricular</span>
            <span class="text-sm">↓</span>
          </a>
          <a 
            href="#contact" 
            class="px-5 py-2.5 rounded-xl bg-white/5 hover:bg-white/10 text-white border border-white/15 font-semibold text-xs font-mono transition"
          >
            Iniciar Contacto
          </a>
        </div>
      </div>

      <!-- Columna Foto de Perfil con Halo Gradiente (5 columnas) -->
      <div class="lg:col-span-5 flex justify-center lg:justify-end">
        <div class="relative group">
          <!-- Brillo de fondo con degradado púrpura/cian -->
          <div class="absolute -inset-1 rounded-3xl bg-gradient-to-r from-purple-600 via-indigo-600 to-cyan-500 opacity-30 group-hover:opacity-60 blur-xl transition duration-700"></div>
          
          <div class="relative w-72 h-80 sm:w-80 sm:h-96 rounded-2xl overflow-hidden border border-white/15 bg-[#121622] shadow-2xl">
            <img 
              src="/profile.png" 
              alt="Roberto Carlos Rivera Valderrama" 
              class="w-full h-full object-cover grayscale contrast-125 group-hover:grayscale-0 transition duration-500"
            />
          </div>
        </div>
      </div>

    </div>

    <!-- SECCIÓN ÁREAS DE ESPECIALIDAD: Consola Reactiva & Bloques Técnicos -->
    <div class="space-y-8 pt-12 border-t border-white/10">
      <div class="flex items-center gap-2">
        <span class="w-2.5 h-2.5 rounded-full bg-cyan-400"></span>
        <h2 class="text-xs font-mono uppercase tracking-widest text-cyan-400 font-semibold">
          Especialización de Ingeniería
        </h2>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
        
        <!-- Acordeón / Lista de Dominios (6 columnas) -->
        <div class="lg:col-span-6 space-y-3 font-mono text-xs">
          
          <div class="p-4 rounded-xl bg-[#121622] border border-white/10 hover:border-cyan-400/40 transition space-y-1">
            <div class="flex items-center justify-between text-white font-bold text-sm">
              <span class="flex items-center gap-2 text-cyan-400">
                <span>&lt;/&gt;</span> Desarrollo Web &amp; Software
              </span>
              <span class="text-[10px] text-slate-500">WASM / WebGL</span>
            </div>
            <p class="text-slate-400 font-sans text-xs pt-1 leading-relaxed">
              Interfaces modernas, simulación 3D interactiva y motores de ejecución cliente autónomos con SQLite WASM y Three.js.
            </p>
          </div>

          <div class="p-4 rounded-xl bg-[#121622] border border-white/10 hover:border-purple-400/40 transition space-y-1">
            <div class="flex items-center justify-between text-white font-bold text-sm">
              <span class="flex items-center gap-2 text-purple-400">
                <span>📊</span> Ciencia de Datos &amp; Modelado
              </span>
              <span class="text-[10px] text-slate-500">Python / R</span>
            </div>
            <p class="text-slate-400 font-sans text-xs pt-1 leading-relaxed">
              Pipelines cuantitativos, contrastes de hipótesis analíticas, correlación formal y reportes automatizados.
            </p>
          </div>

          <div class="p-4 rounded-xl bg-[#121622] border border-white/10 hover:border-indigo-400/40 transition space-y-1">
            <div class="flex items-center justify-between text-white font-bold text-sm">
              <span class="flex items-center gap-2 text-indigo-400">
                <span>🗄️</span> Bases de Datos &amp; SQL
              </span>
              <span class="text-[10px] text-slate-500">Relational Modeling</span>
            </div>
            <p class="text-slate-400 font-sans text-xs pt-1 leading-relaxed">
              Normalización avanzada de esquemas (1FN a 3FN), optimización de índices y motores SQL en el cliente sin backend.
            </p>
          </div>

          <div class="p-4 rounded-xl bg-[#121622] border border-white/10 hover:border-emerald-400/40 transition space-y-1">
            <div class="flex items-center justify-between text-white font-bold text-sm">
              <span class="flex items-center gap-2 text-emerald-400">
                <span>📖</span> Metodología &amp; EdTech
              </span>
              <span class="text-[10px] text-slate-500">Analytics</span>
            </div>
            <p class="text-slate-400 font-sans text-xs pt-1 leading-relaxed">
              Learning Analytics, telemetría de rendimiento y aplicación rigurosa de decretos institucionales.
            </p>
          </div>

        </div>

        <!-- Terminal / Consola Interactiva en React (6 columnas) -->
        <div class="lg:col-span-6">
          <CodeTerminal client:visible />
        </div>

      </div>
    </div>

  </div>
</section>
