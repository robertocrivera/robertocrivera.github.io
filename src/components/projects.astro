---
interface Project {
  title: string;
  description: string;
  tags: string[];
  image: string;
  link: string;
  preview: string;
  status: string;
}

const projects: Project[] = [
  {
    title: "Plataforma Web Interactiva & Recursos Educativos",
    description: "Aplicación interactiva y prototipos web ligeros construidos con JavaScript moderno, interfaces adaptables y lógica modular para entornos de aprendizaje dinámico.",
    tags: ["JavaScript", "HTML5/CSS3", "Tailwind CSS"],
    image: "https://images.unsplash.com/photo-1551288049-bebda4e38f71?q=80&w=800&auto=format&fit=crop",
    link: "https://github.com/robertocrivera",
    preview: "https://robertocrivera.github.io",
    status: "Producción",
  },
  {
    title: "Pipeline de Analítica & Modelado Estadístico",
    description: "Flujos de ingesta, depuración y visualización cuantitativa formal para contrastes de hipótesis, correlaciones analíticas y generación automatizada de reportes.",
    tags: ["Python", "R", "Pandas", "SPSS"],
    image: "https://images.unsplash.com/photo-1504868584819-f8e8b4b6d7e3?q=80&w=800&auto=format&fit=crop",
    link: "https://github.com/robertocrivera",
    preview: "https://github.com/robertocrivera",
    status: "Investigación",
  },
  {
    title: "Motor de Auditoría de Integridad Académica",
    description: "Arquitectura analítica basada en procesamiento de lenguaje natural y heurísticas avanzadas de verificación documental para control de originalidad y coherencia discursiva.",
    tags: ["Python", "NLP", "Análisis Heurístico"],
    image: "https://images.unsplash.com/photo-1456513080510-7bf3a84b82f8?q=80&w=800&auto=format&fit=crop",
    link: "https://github.com/robertocrivera",
    preview: "https://github.com/robertocrivera",
    status: "Completado",
  },
  {
    title: "Arquitectura de Datos Relacional & SQL Engine",
    description: "Diseño y normalización de esquemas en bases de datos relacionales, optimización de consultas complejas y persistencia eficiente para sistemas de información.",
    tags: ["PostgreSQL", "Oracle", "MySQL", "SQLite"],
    image: "https://images.unsplash.com/photo-1544383835-bda2bc66a55d?q=80&w=800&auto=format&fit=crop",
    link: "https://github.com/robertocrivera",
    preview: "https://github.com/robertocrivera",
    status: "Activo",
  },
];
---

<section
  id="projects"
  class="py-16 border-t border-[#ffffff10] text-[var(--white)]"
>
  <div class="max-w-5xl mx-auto px-4">
    <h2 class="text-lg text-[var(--sec)] mb-2 shiny-sec font-mono">Portafolio Técnico</h2>
    <h3 class="text-4xl md:text-5xl font-medium mb-10">Proyectos Destacados</h3>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {
        projects.map((project) => (
          <div class="group border border-[var(--white-icon-tr)] bg-[#14141460] rounded-2xl overflow-hidden hover:border-[var(--sec)]/50 transition-all duration-300 flex flex-col justify-between">
            <div>
              <div class="overflow-hidden relative aspect-video bg-[#1a1a1a]">
                <img
                  src={project.image}
                  alt={project.title}
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 opacity-80 group-hover:opacity-100"
                  loading="lazy"
                />
                <span class="absolute top-3 right-3 text-xs px-2.5 py-1 rounded-full bg-black/70 border border-white/10 backdrop-blur-md text-[var(--white-icon)] font-medium">
                  {project.status}
                </span>
              </div>

              <div class="p-5 space-y-3">
                <div class="flex flex-wrap gap-1.5">
                  {project.tags.map((tag) => (
                    <span class="text-[11px] font-mono px-2 py-0.5 rounded-md bg-[var(--white-icon-tr)] text-[var(--white-icon)]">
                      {tag}
                    </span>
                  ))}
                </div>

                <h4 class="text-xl font-semibold text-[var(--white)] group-hover:text-[var(--sec)] transition-colors">
                  {project.title}
                </h4>

                <p class="text-sm text-[var(--white-icon)] leading-relaxed">
                  {project.description}
                </p>
              </div>
            </div>

            <div class="p-5 pt-0 flex items-center justify-end gap-2 border-t border-white/5 mt-4">
              <a
                target="_blank"
                href={project.link}
                aria-label="Código en GitHub"
                title="Ver código fuente"
                class="size-11 flex justify-center items-center text-[var(--white-icon)] hover:text-white transition duration-300 border border-[var(--white-icon-tr)] rounded-xl bg-[#1414149c] hover:bg-[var(--white-icon-tr)] hover:scale-105"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                  class="size-5"
                >
                  <path d="M24 12L18.3431 17.6569L16.9289 16.2426L21.1716 12L16.9289 7.75736L18.3431 6.34315L24 12ZM2.82843 12L7.07107 16.2426L5.65685 17.6569L0 12L5.65685 6.34315L7.07107 7.75736L2.82843 12ZM9.78845 21H7.66009L14.2116 3H16.3399L9.78845 21Z" />
                </svg>
              </a>
              <a
                target="_blank"
                href={project.preview}
                aria-label="Demo / Vista previa"
                title="Ver demostración"
                class="size-11 flex justify-center items-center text-[var(--white-icon)] hover:text-white transition duration-300 border border-[var(--white-icon-tr)] rounded-xl bg-[#1414149c] hover:bg-[var(--white-icon-tr)] hover:scale-105"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                  class="size-5"
                >
                  <path d="M16.0037 9.41421L7.39712 18.0208L5.98291 16.6066L14.5895 8H7.00373V6H18.0037V17H16.0037V9.41421Z" />
                </svg>
              </a>
            </div>
          </div>
        ))
      }
    </div>

    <a
      target="_blank"
      href="https://github.com/robertocrivera"
      aria-label="GitHub"
      class="w-full max-w-md mx-auto flex items-center justify-center gap-2 mt-12 text-[var(--white-icon)] hover:text-white transition duration-300 border border-[var(--white-icon-tr)] py-3 px-6 rounded-full bg-[#1414149c] hover:bg-[var(--white-icon-tr)] hover:scale-105 shadow-lg"
    >
      <span class="md:text-base text-sm font-medium">Explorar más repositorios en</span>
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="currentColor"
        class="size-5"
      >
        <path
          d="M12.001 2C6.47598 2 2.00098 6.475 2.00098 12C2.00098 16.425 4.86348 20.1625 8.83848 21.4875C9.33848 21.575 9.52598 21.275 9.52598 21.0125C9.52598 20.775 9.51348 19.9875 9.51348 19.15C7.00098 19.6125 6.35098 18.5375 6.15098 17.975C6.03848 17.6875 5.55098 16.8 5.12598 16.5625C4.77598 16.375 4.27598 15.9125 5.11348 15.9C5.90098 15.8875 6.46348 16.625 6.65098 16.925C7.55098 18.4375 8.98848 18.0125 9.56348 17.75C9.65098 17.1 9.91348 16.6625 10.201 16.4125C7.97598 16.1625 5.65098 15.3 5.65098 11.475C5.65098 10.3875 6.03848 9.4875 6.67598 8.7875C6.57598 8.5375 6.22598 7.5125 6.77598 6.1375C6.77598 6.1375 7.61348 5.875 9.52598 7.1625C10.326 6.9375 11.176 6.825 12.026 6.825C12.876 6.825 13.726 6.9375 14.526 7.1625C16.4385 5.8625 17.276 6.1375 17.276 6.1375C17.826 7.5125 17.476 8.5375 17.376 8.7875C18.0135 9.4875 18.401 10.375 18.401 11.475C18.401 15.3125 16.0635 16.1625 13.8385 16.4125C14.201 16.725 14.5135 17.325 14.5135 18.2625C14.5135 19.6 14.501 20.675 14.501 21.0125C14.501 21.275 14.6885 21.5875 15.1885 21.4875C19.259 20.1133 21.9999 16.2963 22.001 12C22.001 6.475 17.526 2 12.001 2Z"
        ></path>
      </svg>
    </a>
  </div>
</section>
