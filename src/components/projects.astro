<section id="projects" class="py-16 border-t border-[#ffffff10] text-slate-100">
  <div class="max-w-7xl mx-auto px-4 space-y-8">
    
    <!-- Encabezado de la Galería -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-5 border-b border-white/10 pb-6">
      <div>
        <div class="flex items-center gap-2 mb-2">
          <span class="w-2 h-2 rounded-full bg-[var(--sec)] animate-pulse"></span>
          <h2 class="text-xs font-mono uppercase tracking-widest text-[var(--sec)]">Showcase & Repositorios</h2>
        </div>
        <h3 class="text-3xl md:text-4xl font-bold tracking-tight text-white">Catálogo de Proyectos</h3>
      </div>

      <!-- Barra de Filtro de Categorías -->
      <div class="flex items-center p-1 rounded-xl bg-[#121622] border border-white/10 text-xs font-mono overflow-x-auto">
        <button data-filter="all" class="filter-tab active px-3.5 py-1.5 rounded-lg font-semibold transition cursor-pointer shrink-0">
          Todos (7)
        </button>
        <button data-filter="edtech" class="filter-tab px-3.5 py-1.5 rounded-lg text-slate-400 hover:text-white transition cursor-pointer shrink-0">
          EdTech (4)
        </button>
        <button data-filter="datascience" class="filter-tab px-3.5 py-1.5 rounded-lg text-slate-400 hover:text-white transition cursor-pointer shrink-0">
          Data Science (1)
        </button>
        <button data-filter="database" class="filter-tab px-3.5 py-1.5 rounded-lg text-slate-400 hover:text-white transition cursor-pointer shrink-0">
          SQL & WASM (1)
        </button>
        <button data-filter="robotics" class="filter-tab px-3.5 py-1.5 rounded-lg text-slate-400 hover:text-white transition cursor-pointer shrink-0">
          Robótica 3D (1)
        </button>
      </div>
    </div>

    <!-- Grid de Tarjetas en 3 Columnas -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" id="projects-container">
      {
        projects.map((project) => (
          <article 
            id={`card-${project.id}`}
            data-project-id={project.id}
            data-category={project.categorySlug}
            class="project-item group bg-[#131722] hover:bg-[#171c2b] border border-white/10 hover:border-white/20 rounded-2xl p-4 transition-all duration-300 flex flex-col justify-between shadow-lg"
          >
            <div class="space-y-3">
              <!-- Encabezado de la Tarjeta -->
              <div class="flex items-center justify-between gap-2">
                <div class="flex items-center gap-2 min-w-0">
                  <div class="w-7 h-7 rounded-lg bg-white/5 border border-white/10 flex items-center justify-center text-xs font-mono text-[var(--sec)] shrink-0">
                    &gt;_
                  </div>
                  <h4 class="text-sm font-semibold text-white truncate group-hover:text-[var(--sec)] transition-colors" title={project.title}>
                    {project.title}
                  </h4>
                </div>

                <div class="flex items-center gap-1 shrink-0">
                  <a 
                    href={project.link} 
                    target="_blank" 
                    rel="noopener noreferrer"
                    data-track-run={project.id}
                    title="Ver Código en GitHub"
                    class="track-action p-1.5 rounded-lg text-slate-400 hover:text-white hover:bg-white/10 transition"
                  >
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/></svg>
                  </a>
                  <a 
                    href={project.preview} 
                    target="_blank" 
                    rel="noopener noreferrer"
                    data-track-run={project.id}
                    title="Abrir Demostración en Vivo"
                    class="track-action p-1.5 rounded-lg text-slate-400 hover:text-[var(--sec)] hover:bg-white/10 transition"
                  >
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
                  </a>
                </div>
              </div>

              <!-- Imagen de Altura Compacta -->
              <a 
                href={project.preview} 
                target="_blank" 
                rel="noopener noreferrer"
                data-track-run={project.id}
                class="track-action block relative aspect-[16/8] rounded-xl overflow-hidden bg-black/60 border border-white/5 group-hover:border-white/20 transition-all cursor-pointer"
              >
                <img 
                  src={project.image} 
                  alt={project.title}
                  loading="lazy"
                  class="w-full h-full object-cover opacity-85 group-hover:opacity-100 group-hover:scale-105 transition-all duration-500"
                />
                <span class="absolute top-2 left-2 px-2 py-0.5 rounded-full text-[10px] font-mono font-medium bg-black/70 backdrop-blur border border-white/10 text-slate-200">
                  {project.category}
                </span>
                <span class="absolute top-2 right-2 px-2 py-0.5 rounded-full text-[10px] font-mono font-semibold bg-[var(--sec)]/20 text-[var(--sec)] border border-[var(--sec)]/40 backdrop-blur">
                  {project.status}
                </span>
              </a>

              <!-- Descripción -->
              <p class="text-sm text-slate-300 line-clamp-4 leading-relaxed pt-1">
                {project.description}
              </p>
            </div>

            <!-- Barra Inferior de Métricas & Badges -->
            <div class="flex items-center justify-between pt-4 mt-4 border-t border-white/5 text-[11px] font-mono text-slate-400">
              <div class="flex items-center gap-2.5">
                <span class="flex items-center gap-1 hover:text-slate-200 transition" title="Visitas / Interacciones">
                  <svg class="w-3.5 h-3.5 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
                  <span id={`views-${project.id}`}>{project.initialMetrics.views}</span>
                </span>
                <span class="flex items-center gap-1 hover:text-slate-200 transition" title="Aperturas de Demo o Código">
                  <svg class="w-3.5 h-3.5 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                  <span id={`runs-${project.id}`}>{project.initialMetrics.runs}</span>
                </span>
                <span class="flex items-center gap-0.5 text-[var(--sec)]" title="Score de Confiabilidad">
                  <span>★</span> {project.initialMetrics.score}
                </span>
              </div>

              <div class="flex items-center gap-1">
                {project.tags.slice(0, 2).map((tag) => (
                  <span class="px-1.5 py-0.5 rounded bg-white/5 text-[10px] text-slate-400 border border-white/5">
                    {tag}
                  </span>
                ))}
              </div>
            </div>
          </article>
        ))
      }
    </div>

    <!-- Botón Inferior -->
    <div class="pt-6 text-center">
      <a
        href="https://github.com/robertocrivera"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 px-6 py-2.5 rounded-xl bg-[#121622] hover:bg-[#181e2e] border border-white/10 hover:border-white/20 text-xs font-mono text-slate-300 hover:text-white transition shadow-sm"
      >
        <span>Explorar todos los repositorios en GitHub</span>
        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
          <path d="M12.001 2C6.47598 2 2.00098 6.475 2.00098 12C2.00098 16.425 4.86348 20.1625 8.83848 21.4875C9.33848 21.575 9.52598 21.275 9.52598 21.0125C9.52598 20.775 9.51348 19.9875 9.51348 19.15C7.00098 19.6125 6.35098 18.5375 6.15098 17.975C6.03848 17.6875 5.55098 16.8 5.12598 16.5625C4.77598 16.375 4.27598 15.9125 5.11348 15.9C5.90098 15.8875 6.46348 16.625 6.65098 16.925C7.55098 18.4375 8.98848 18.0125 9.56348 17.75C9.65098 17.1 9.91348 16.6625 10.201 16.4125C7.97598 16.1625 5.65098 15.3 5.65098 11.475C5.65098 10.3875 6.03848 9.4875 6.67598 8.7875C6.57598 8.5375 6.22598 7.5125 6.77598 6.1375C6.77598 6.1375 7.61348 5.875 9.52598 7.1625C10.326 6.9375 11.176 6.825 12.026 6.825C12.876 6.825 13.726 6.9375 14.526 7.1625C16.4385 5.8625 17.276 6.1375 17.276 6.1375C17.826 7.5125 17.476 8.5375 17.376 8.7875C18.0135 9.4875 18.401 10.375 18.401 11.475C18.401 15.3125 16.0635 16.1625 13.8385 16.4125C14.201 16.725 14.5135 17.325 14.5135 18.2625C14.5135 19.6 14.501 20.675 14.501 21.0125C14.501 21.275 14.6885 21.5875 15.1885 21.4875C19.259 20.1133 21.9999 16.2963 22.001 12C22.001 6.475 17.526 2 12.001 2Z"/>
        </svg>
      </a>
    </div>

  </div>
</section>

<!-- Manejador de Filtros y Métricas -->
<script is:inline>
  const tabs = document.querySelectorAll('.filter-tab');
  const cards = document.querySelectorAll('.project-item');

  tabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      tabs.forEach((t) => {
        t.classList.remove('active', 'bg-[var(--sec)]', 'text-slate-950');
        t.classList.add('text-slate-400');
      });
      tab.classList.add('active', 'bg-[var(--sec)]', 'text-slate-950');
      tab.classList.remove('text-slate-400');

      const filterVal = tab.getAttribute('data-filter');
      cards.forEach((card) => {
        const cardCat = card.getAttribute('data-category');
        if (filterVal === 'all' || cardCat === filterVal) {
          card.style.display = 'flex';
        } else {
          card.style.display = 'none';
        }
      });
    });
  });

  const defaultTab = document.querySelector('.filter-tab[data-filter="all"]');
  if (defaultTab) {
    defaultTab.classList.add('bg-[var(--sec)]', 'text-slate-950');
    defaultTab.classList.remove('text-slate-400');
  }

  // Se añade 'p7' a la reactividad de métricas locales
  const projectIds = ['p1', 'p2', 'p3', 'p4', 'p5', 'p6', 'p7'];
  projectIds.forEach((id) => {
    let views = parseInt(localStorage.getItem(`proj_views_${id}`) || '0', 10);
    views += 1;
    localStorage.setItem(`proj_views_${id}`, views.toString());

    const viewEl = document.getElementById(`views-${id}`);
    if (viewEl) viewEl.textContent = views.toString();

    const runs = parseInt(localStorage.getItem(`proj_runs_${id}`) || '0', 10);
    const runsEl = document.getElementById(`runs-${id}`);
    if (runsEl) runsEl.textContent = runs.toString();
  });

  document.querySelectorAll('.track-action').forEach((btn) => {
    btn.addEventListener('click', () => {
      const pid = btn.getAttribute('data-track-run');
      if (pid) {
        let currentRuns = parseInt(localStorage.getItem(`proj_runs_${pid}`) || '0', 10);
        currentRuns += 1;
        localStorage.setItem(`proj_runs_${pid}`, currentRuns.toString());

        const runsEl = document.getElementById(`runs-${pid}`);
        if (runsEl) runsEl.textContent = currentRuns.toString();
      }
    });
  });
</script>

<style>
  .line-clamp-4 {
    display: -webkit-box;
    -webkit-line-clamp: 4;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
