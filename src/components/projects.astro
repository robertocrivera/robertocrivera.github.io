---
interface Project {
  title: string;
  description: string;
  category: string;
  categorySlug: string;
  tags: string[];
  image: string;
  link: string;
  preview: string;
  status: string;
}

const projects: Project[] = [
  {
    title: "Plataforma Web Interactiva & Recursos Educativos",
    description: "Aplicación interactiva y prototipos web ligeros construidos con JavaScript moderno, interfaces adaptables y lógica modular para entornos de aprendizaje dinámico.",
    category: "EdTech & Plataformas Web",
    categorySlug: "edtech",
    tags: ["JavaScript", "HTML5/CSS3", "Tailwind CSS"],
    image: "https://images.unsplash.com/photo-1551288049-bebda4e38f71?q=80&w=800&auto=format&fit=crop",
    link: "https://github.com/robertocrivera/recurso-educativo-demo",
    preview: "https://robertocrivera.github.io/recurso-educativo-demo/",
    status: "Producción",
  },
  {
    title: "Sistema de Evaluación & Analítica Educativa",
    description: "Plataforma analítica y dashboard institucional para gestión de calificaciones bajo el Decreto 1290 (1.0 a 5.0), cuadro de honor, alertas tempranas de deserción y emisión de boletines procesados con SQLite WASM y Excel.",
    category: "EdTech & Plataformas Web",
    categorySlug: "edtech",
    tags: ["JavaScript", "SQLite WASM", "Chart.js", "SheetJS"],
    image: "https://images.unsplash.com/photo-1460925895917-afdab827c52f?q=80&w=800&auto=format&fit=crop",
    link: "https://github.com/robertocrivera/sistema-evaluacion-analitica",
    preview: "https://robertocrivera.github.io/sistema-evaluacion-analitica/",
    status: "Producción",
  },
  {
    title: "Pipeline de Analítica & Modelado Estadístico",
    description: "Flujos de ingesta, depuración y visualización cuantitativa formal para contrastes de hipótesis, correlaciones analíticas y generación automatizada de reportes.",
    category: "Data Science & Motores SQL",
    categorySlug: "data-sql",
    tags: ["Python", "R", "Pandas", "SPSS"],
    image: "https://images.unsplash.com/photo-1504868584819-f8e8b4b6d7e3?q=80&w=800&auto=format&fit=crop",
    link: "https://github.com/robertocrivera/Pipeline-analitica-estadistica",
    preview: "https://github.com/robertocrivera",
    status: "Investigación",
  },
  {
    title: "Laboratorio de Arquitectura Relacional & SQL Engine",
    description: "Entorno interactivo y tutor de modelado relacional (1FN a 3FN). Integra 15 lecciones estructuradas, checkpoints diagnósticos, diagramación ER en tiempo real y motor de ejecución en el cliente con SQLite WASM.",
    category: "Data Science & Motores SQL",
    categorySlug: "data-sql",
    tags: ["SQLite WASM", "SQL Engine", "1FN a 3FN", "Tailwind CSS"],
    image: "https://images.unsplash.com/photo-1544383835-bda2bc66a55d?q=80&w=800&auto=format&fit=crop",
    link: "https://github.com/robertocrivera/sql-relational-engine",
    preview: "https://robertocrivera.github.io/sql-relational-engine/",
    status: "Producción",
  }
];
---

<section id="projects" class="py-16 border-t border-[#ffffff10] text-[var(--white)]">
  <div class="max-w-5xl mx-auto px-4">
    <div class="flex flex-wrap items-end justify-between gap-4 mb-8">
      <div>
        <h2 class="text-lg text-[var(--sec)] mb-2 shiny-sec font-mono">Portafolio Técnico</h2>
        <h3 class="text-4xl md:text-5xl font-medium">Catálogo por Dominios</h3>
      </div>

      <!-- Barra de Filtro de Categorías -->
      <div class="flex flex-wrap gap-2 p-1.5 rounded-xl bg-white/5 border border-white/10 font-mono text-xs">
        <button data-filter="all" class="filter-btn active px-3.5 py-1.5 rounded-lg bg-[var(--sec)] text-slate-950 font-bold transition">
          Todos (4)
        </button>
        <button data-filter="edtech" class="filter-btn px-3.5 py-1.5 rounded-lg text-slate-300 hover:text-white transition">
          EdTech & Web (2)
        </button>
        <button data-filter="data-sql" class="filter-btn px-3.5 py-1.5 rounded-lg text-slate-300 hover:text-white transition">
          Data Science & SQL (2)
        </button>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8" id="projects-grid">
      {
        projects.map((project) => (
          <div data-category={project.categorySlug} class="project-card group border border-[var(--white-icon-tr)] bg-[#14141460] rounded-2xl overflow-hidden hover:border-[var(--sec)]/50 transition-all duration-300 flex flex-col justify-between">
            <div>
              <div class="overflow-hidden relative aspect-video bg-[#1a1a1a]">
                <img
                  src={project.image}
                  alt={project.title}
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 opacity-80 group-hover:opacity-100"
                  loading="lazy"
                />
                <span class="absolute top-3 left-3 text-[10px] font-mono px-2 py-0.5 rounded-full bg-slate-950/80 border border-white/10 backdrop-blur-md text-[var(--sec)]">
                  {project.category}
                </span>
                <span class="absolute top-3 right-3 text-xs px-2.5 py-1 rounded-full bg-black/70 border border-white/10 backdrop-blur-md text-[var(--white-icon)] font-medium">
                  {project.status}
                </span>
              </div>

              <div class="p-5 space-y-3">
                <div class="flex flex-wrap gap-1.5">
                  {project.tags.map((tag) => (
                    <span class="text-[11px] font-mono px-2 py-0.5 rounded-md bg-[var(--white-icon-tr)] text-[var(--white-icon)]">
                      {tag}
                    </span>
                  ))}
                </div>

                <h4 class="text-xl font-semibold text-[var(--white)] group-hover:text-[var(--sec)] transition-colors">
                  {project.title}
                </h4>

                <p class="text-sm text-[var(--white-icon)] leading-relaxed">
                  {project.description}
                </p>
              </div>
            </div>

            <div class="p-5 pt-0 flex items-center justify-end gap-2 border-t border-white/5 mt-4">
              <a
                target="_blank"
                href={project.link}
                aria-label="Código en GitHub"
                title="Ver código fuente"
                class="size-11 flex justify-center items-center text-[var(--white-icon)] hover:text-white transition duration-300 border border-[var(--white-icon-tr)] rounded-xl bg-[#1414149c] hover:bg-[var(--white-icon-tr)] hover:scale-105"
              >
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-5">
                  <path d="M24 12L18.3431 17.6569L16.9289 16.2426L21.1716 12L16.9289 7.75736L18.3431 6.34315L24 12ZM2.82843 12L7.07107 16.2426L5.65685 17.6569L0 12L5.65685 6.34315L7.07107 7.75736L2.82843 12ZM9.78845 21H7.66009L14.2116 3H16.3399L9.78845 21Z" />
                </svg>
              </a>
              <a
                target="_blank"
                href={project.preview}
                aria-label="Demo / Vista previa"
                title="Ver demostración"
                class="size-11 flex justify-center items-center text-[var(--white-icon)] hover:text-white transition duration-300 border border-[var(--white-icon-tr)] rounded-xl bg-[#1414149c] hover:bg-[var(--white-icon-tr)] hover:scale-105"
              >
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-5">
                  <path d="M16.0037 9.41421L7.39712 18.0208L5.98291 16.6066L14.5895 8H7.00373V6H18.0037V17H16.0037V9.41421Z" />
                </svg>
              </a>
            </div>
          </div>
        ))
      }
    </div>

    <script is:inline>
      const buttons = document.querySelectorAll('.filter-btn');
      const cards = document.querySelectorAll('.project-card');

      buttons.forEach((btn) => {
        btn.addEventListener('click', () => {
          buttons.forEach((b) => {
            b.classList.remove('bg-[var(--sec)]', 'text-slate-950', 'font-bold');
            b.classList.add('text-slate-300');
          });
          btn.classList.add('bg-[var(--sec)]', 'text-slate-950', 'font-bold');
          btn.classList.remove('text-slate-300');

          const filter = btn.getAttribute('data-filter');
          cards.forEach((card) => {
            if (filter === 'all' || card.getAttribute('data-category') === filter) {
              card.style.display = 'flex';
            } else {
              card.style.display = 'none';
            }
          });
        });
      });
    </script>
  </div>
</section>
