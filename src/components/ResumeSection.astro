---

<section id="cv-section" class="py-20 border-t border-white/10 text-slate-200">
  <div class="max-w-6xl mx-auto px-4 space-y-16">
    
    <!-- Encabezado de la Sección -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 border-b border-white/10 pb-8">
      <div>
        <div class="flex items-center gap-2 mb-2">
          <span class="w-2.5 h-2.5 rounded-full bg-cyan-400 animate-pulse"></span>
          <span class="text-xs font-mono uppercase tracking-widest text-cyan-400 font-semibold">Perfil Profesional & Trayectoria</span>
        </div>
        <h2 class="text-3xl md:text-5xl font-bold tracking-tight text-white">Currículum & Capacidades</h2>
      </div>

      <div class="flex flex-wrap items-center gap-3">
        <a 
          href="#contacto" 
          class="px-5 py-2.5 rounded-xl bg-cyan-500 hover:bg-cyan-400 text-slate-950 font-bold text-xs font-mono transition shadow-lg shadow-cyan-500/20"
        >
          Iniciar Contacto Técnico
        </a>
      </div>
    </div>

    <!-- Grid Principal: Experiencia (Izquierda) + Formación y Garantías (Derecha) -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10">
      
      <!-- Columna Izquierda: Experiencia Técnica (7 Columnas) -->
      <div class="lg:col-span-7 space-y-8">
        <div class="flex items-center gap-2">
          <svg class="w-5 h-5 text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
          </svg>
          <h3 class="text-lg font-bold text-white font-mono uppercase tracking-wider">Trayectoria Profesional</h3>
        </div>

        <div class="space-y-10 relative before:absolute before:inset-0 before:left-3.5 before:w-0.5 before:bg-white/10">
          {experience.map((item) => (
            <div class="relative pl-10 space-y-3 group">
              <!-- Indicador Timeline -->
              <span class="absolute left-2.5 top-1.5 w-2.5 h-2.5 rounded-full bg-cyan-400 ring-4 ring-[#0b0f19] group-hover:scale-125 transition-transform"></span>
              
              <div class="flex flex-wrap items-center justify-between gap-2">
                <h4 class="text-base md:text-lg font-bold text-white group-hover:text-cyan-400 transition-colors">
                  {item.role}
                </h4>
                <span class="text-[11px] font-mono px-2.5 py-0.5 rounded-full bg-cyan-500/10 text-cyan-300 border border-cyan-500/30">
                  {item.period}
                </span>
              </div>
              
              <p class="text-xs font-mono text-slate-400">{item.company}</p>
              <p class="text-xs md:text-sm text-slate-300 leading-relaxed">{item.summary}</p>
              
              <ul class="space-y-2 pt-1">
                {item.achievements.map((ach) => (
                  <li class="text-xs text-slate-400 flex items-start gap-2 leading-relaxed">
                    <span class="text-cyan-400 font-bold mt-0.5">▹</span>
                    <span>{ach}</span>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </div>

      <!-- Columna Derecha: Educación, Certificaciones y Fortalezas (5 Columnas) -->
      <div class="lg:col-span-5 space-y-8">
        
        <!-- Educación -->
        <div class="space-y-4">
          <div class="flex items-center gap-2">
            <svg class="w-5 h-5 text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l9-5-9-5-9 5 9 5z"></path>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z"></path>
            </svg>
            <h3 class="text-lg font-bold text-white font-mono uppercase tracking-wider">Formación & Certificaciones</h3>
          </div>

          <div class="space-y-3">
            {education.map((edu) => (
              <div class="p-4 rounded-xl bg-[#121622]/90 border border-white/10 hover:border-purple-500/40 transition space-y-1.5">
                <div class="flex items-center justify-between">
                  <span class="text-xs font-mono text-purple-400 font-semibold">{edu.institution}</span>
                  <span class="text-[10px] font-mono text-slate-400 px-2 py-0.5 rounded bg-white/5">{edu.status}</span>
                </div>
                <h4 class="text-sm font-bold text-white">{edu.title}</h4>
                <p class="text-xs text-slate-400 leading-relaxed">{edu.detail}</p>
              </div>
            ))}
          </div>
        </div>

        <!-- Diferenciadores Técnicos -->
        <div class="p-5 rounded-2xl bg-gradient-to-br from-cyan-950/30 via-[#121622] to-purple-950/20 border border-cyan-800/30 space-y-4">
          <div class="flex items-center gap-2 text-cyan-300 font-mono text-xs font-bold uppercase tracking-wider">
            <span>⚡</span> Diferenciales de Ingeniería
          </div>
          <div class="space-y-3">
            {technicalStrengths.map((item) => (
              <div class="space-y-0.5">
                <h5 class="text-xs font-bold text-white">{item.label}</h5>
                <p class="text-[11px] text-slate-400 leading-relaxed">{item.desc}</p>
              </div>
            ))}
          </div>
        </div>

      </div>

    </div>
  </div>
</section>
