---
import Layout from "@/layouts/Layout.astro";
import Nav from "@/components/nav.astro";
import Footer from "@/components/footer.astro";

interface Frontmatter {
  title: string;
  description: string;
  date: string;
  tag?: string;
}

interface MarkdownInstance {
  url?: string;
  frontmatter: Frontmatter;
}

// Carga nativa mediante import.meta.glob (estándar moderno de Astro y Vite)
const modules = import.meta.glob<MarkdownInstance>("./posts/*.md", { eager: true });
const rawPosts = Object.values(modules);

const posts = rawPosts.sort(
  (a, b) =>
    new Date(b.frontmatter.date).getTime() - new Date(a.frontmatter.date).getTime()
);
---

<Layout title="Blog | Roberto Carlos Rivera Valderrama">
  <Nav />
  
  <main class="max-w-4xl mx-auto px-4 pt-28 pb-20 text-[var(--white)] min-h-screen">
    <div class="mb-12 text-left space-y-3">
      <span class="text-sm font-mono text-[var(--sec)] shiny-sec tracking-wider uppercase">
        Artículos & Notas Técnicas
      </span>
      <h1 class="text-4xl md:text-5xl font-medium tracking-tight">
        Blog & Investigación
      </h1>
      <p class="text-[var(--white-icon)] text-base md:text-lg max-w-2xl">
        Reflexiones, análisis metodológico, ciencia de datos aplicada y notas de desarrollo de software.
      </p>
    </div>

    <div class="grid grid-cols-1 gap-6">
      {
        posts.map((post) => (
          <article class="p-6 md:p-8 rounded-2xl border border-[var(--white-icon-tr)] bg-[#14141460] hover:border-[var(--sec)]/40 hover:bg-[#14141499] transition-all duration-300 group">
            <a href={post.url} class="block space-y-3">
              <div class="flex flex-wrap items-center gap-3 text-xs text-[var(--white-icon)] font-mono">
                <time datetime={post.frontmatter.date}>
                  {new Date(post.frontmatter.date).toLocaleDateString("es-ES", {
                    year: "numeric",
                    month: "long",
                    day: "numeric",
                  })}
                </time>
                <span>•</span>
                <span class="text-[var(--sec)]">{post.frontmatter.tag || "General"}</span>
              </div>

              <h2 class="text-2xl md:text-3xl font-semibold text-[var(--white)] group-hover:text-[var(--sec)] transition-colors">
                {post.frontmatter.title}
              </h2>

              <p class="text-[var(--white-icon)] text-sm md:text-base leading-relaxed line-clamp-3">
                {post.frontmatter.description}
              </p>

              <div class="pt-2 flex items-center text-sm font-medium text-[var(--sec)] gap-1 group-hover:translate-x-1 transition-transform">
                <span>Leer publicación completa</span>
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-4">
                  <path d="M16.1716 10.9999L10.8076 5.63589L12.2218 4.22168L20 11.9999L12.2218 19.778L10.8076 18.3638L16.1716 12.9999H4V10.9999H16.1716Z"></path>
                </svg>
              </div>
            </a>
          </article>
        ))
      }
    </div>
  </main>

  <Footer />
</Layout>
